---
// src/pages/index.astro
import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL;
---

<BaseLayout title="Rabiah Khanum — Technical Writer Portfolio">
    <!-- Hero Section -->
    <section class="hero">
        <div class="hero-card">
            <h1 class="hero-title">Rabiah Khanum</h1>
            <p class="hero-description">
                Technical Writer & Electrical Engineer building clear, scalable documentation 
                for complex systems, from cloud networking to docs-as-code workflows.
            </p>
            <a href={`${base}about`} class="btn btn-primary">
                Get to Know me
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" width="14" height="14" aria-hidden="true">
                  <path fill-rule="evenodd" d="M3 10a.75.75 0 0 1 .75-.75h10.638L10.23 5.29a.75.75 0 1 1 1.04-1.08l5.5 5.25a.75.75 0 0 1 0 1.08l-5.5 5.25a.75.75 0 1 1-1.04-1.08l4.158-3.96H3.75A.75.75 0 0 1 3 10Z" clip-rule="evenodd" />
                </svg>
            </a>
        </div>
    </section>

</BaseLayout>

<style>
    /* Hero Section */
    .hero {
        min-height: 85vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 5rem 2rem 2rem;
    }

    .hero-card {
        max-width: 900px;
        background: rgba(255, 255, 255, 0.9);
        backdrop-filter: blur(8px);
        border-radius: 24px;
        padding: 3rem;
        box-shadow: 0 25px 50px -12px rgba(139, 92, 246, 0.15);
        animation: fadeInUp 0.8s ease-out;
    }

    @keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(30px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .hero-subtitle {
        font-size: 0.85rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: #9ca3af;
        margin-bottom: 1rem;
    }

    .hero-title {
        font-family: 'Playfair Display', serif;
        font-size: 3.5rem;
        font-weight: 700;
        color: #1e293b;
        margin-bottom: 1.5rem;
        line-height: 1.2;
    }

    .hero-description {
        font-size: 1.15rem;
        color: #475569;
        margin-bottom: 2rem;
        line-height: 1.7;
    }

    .cta-buttons {
        display: flex;
        gap: 1rem;
        flex-wrap: wrap;
    }

    .btn {
        padding: 0.875rem 2rem;
        border-radius: 12px;
        font-weight: 500;
        text-decoration: none;
        transition: all 0.2s;
        font-size: 0.95rem;
        display: inline-block;
    }

    .btn-primary {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        background: #0d9488;
        color: #ffff;
        font-size: 0.875rem;
        font-weight: 500;
        text-decoration: none;
        padding: 0.55rem 1.1rem;
        border: 1.5px solid #0d9488;
        border-radius: 99px;
        margin-top: 0.5rem;
        transition: background 0.2s, color 0.2s;
    }

    .btn-primary:hover {
        background: #ffff;
        color: #0d9488;
        }

    /* Responsive */
    @media (max-width: 768px) {
        .hero-title {
            font-size: 2.5rem;
        }

        .hero-card {
            padding: 2rem;
        }

    }
</style>