---
import BaseLayout from "../../layouts/BaseLayout.astro";

const joinPath = (...parts: string[]) => {
  return parts
    .map((part, index) => {
      if (index > 0 && part.startsWith('/')) part = part.slice(1);
      if (index < parts.length - 1 && part.endsWith('/')) part = part.slice(0, -1);
      return part;
    })
    .join('/');
};

const baseUrl = import.meta.env.BASE_URL;
---

<BaseLayout>
  <div class="page-wrapper">
    <div class="page-card">

      <!-- ── Header ── -->
      <h1 class="page-title">Documentation Work</h1>
      <p class="page-subtitle">
        A selection of documentation projects focused on clarity, real-world use cases, and scalable structure.
      </p>

      <hr class="divider" />

      <!-- ── Featured Documentation ── -->
      <section class="section">
        <h2 class="section-heading">Featured Documentation</h2>

        <!-- Linux Firewall -->
        <div class="doc-card doc-card-teal">
          <div class="doc-card-inner">
            <div class="doc-card-main">
              <h3 class="doc-title">Linux Firewall Configuration Guide</h3>
              <div class="doc-meta">
                <span><strong>Tools:</strong> Ubuntu, UFW, GitHub Pages</span>
                <span><strong>Focus:</strong> Beginner-friendly firewall setup</span>
              </div>
              <ul class="section-preview">
                <li>
                  <a href={joinPath(baseUrl, 'docs', 'linux-firewall') + '#ufw-and-its-role-in-network-security'}>
                    UFW and its role in network security
                  </a>
                </li>
                <li>
                  <a href={joinPath(baseUrl, 'docs', 'linux-firewall') + '#prerequisites-and-installation'}>
                    Prerequisites and installation
                  </a>
                </li>
                <li>
                  <a href={joinPath(baseUrl, 'docs', 'linux-firewall') + '#how-to-setup-a-simple-firewall-rule'}>
                    How to setup a simple firewall rule
                  </a>
                </li>
                <li>
                  <a href={joinPath(baseUrl, 'docs', 'linux-firewall') + '#step-5-verify-the-configuration'}>
                    Verifying and testing your configuration
                  </a>
                </li>
              </ul>
            </div>
            <div class="doc-card-actions">
              <a href={joinPath(baseUrl, 'docs', 'linux-firewall')} class="btn btn-primary-teal">View Docs</a>
              <a href="https://github.com/Khanum49/linux-firewall-guide" target="_blank" class="btn btn-outline-teal">GitHub</a>
            </div>
          </div>
        </div>

        <!-- Inter-VLAN -->
        <div class="doc-card doc-card-purple">
          <div class="doc-card-inner">
            <div class="doc-card-main">
              <h3 class="doc-title">Inter-VLAN Routing Configuration</h3>
              <div class="doc-meta">
                <span><strong>Tools:</strong> Cisco Packet Tracer, Router-on-a-Stick</span>
                <span><strong>Focus:</strong> Network segmentation and inter-VLAN communication</span>
              </div>
              <ul class="section-preview">
                <li>
                  <a href={joinPath(baseUrl, 'docs', 'inter-vlan') + '#what-is-inter-vlan-routing'}>
                    What Inter-VLAN routing is and why it's needed
                  </a>
                </li>
                <li>
                  <a href={joinPath(baseUrl, 'docs', 'inter-vlan') + '#lab-scenario'}>
                    Three-department lab scenario (IT, Management, HR)
                  </a>
                </li>
                <li>
                  <a href={joinPath(baseUrl, 'docs', 'inter-vlan') + '#how-to-configure-inter-vlan-routing'}>
                    Step-by-step Cisco Packet Tracer configuration
                  </a>
                </li>
                <li>
                  <a href={joinPath(baseUrl, 'docs', 'inter-vlan') + '#step-6-verify-the-configuration'}>
                    Verifying connectivity across VLANs
                  </a>
                </li>
              </ul>
            </div>
            <div class="doc-card-actions">
              <a href={joinPath(baseUrl, 'docs', 'inter-vlan')} class="btn btn-primary-purple">View Docs</a>
            </div>
          </div>
        </div>
      </section>

      <hr class="divider" />

      <!-- ── Technical Articles ── -->
      <section class="section">
        <h2 class="section-heading">Technical Articles</h2>

        <div class="articles-grid">

          <!-- ESP32 -->
          <div class="article-card article-card-teal">
            <div class="article-top">
              <h3 class="article-title">ESP32 Microcontroller: Features and Applications</h3>
              <p class="article-desc">Overview of ESP32 capabilities, IoT applications, and real-world project examples</p>
              <ul class="section-preview">
                <li>
                  <a href={joinPath(baseUrl, 'docs', 'esp32') + '#what-makes-esp32-special-vs-esp8266'}>
                    What makes ESP32 special vs ESP8266
                  </a>
                </li>
                <li>
                  <a href={joinPath(baseUrl, 'docs', 'esp32') + '#key-features-and-functionality'}>
                    GPIO, Wi-Fi, Bluetooth, and ADC features
                  </a>
                </li>
                <li>
                  <a href={joinPath(baseUrl, 'docs', 'esp32') + '#project-examples'}>
                    11+ real-world project examples
                  </a>
                </li>
              </ul>
            </div>
            <div class="article-footer">
              <div class="tags">
                <span class="tag tag-teal">IoT</span>
                <span class="tag tag-blue">Embedded Systems</span>
              </div>
              <a href={joinPath(baseUrl, 'docs', 'esp32')} class="btn btn-primary-teal btn-sm">Read Article</a>
            </div>
          </div>

          <!-- STM32 -->
          <div class="article-card article-card-purple">
            <div class="article-top">
              <h3 class="article-title">STM32 and ARM Cortex-M: Architecture and Applications</h3>
              <p class="article-desc">Understanding STM32 microcontrollers and ARM Cortex-M processor architecture</p>
              <ul class="section-preview">
                <li>
                  <a href={joinPath(baseUrl, 'docs', 'stm32') + '#arm-cortex-m-series'}>
                    ARM Cortex-M series and core characteristics
                  </a>
                </li>
                <li>
                  <a href={joinPath(baseUrl, 'docs', 'stm32') + '#common-architecture'}>
                    RISC and Harvard architecture explained
                  </a>
                </li>
                <li>
                  <a href={joinPath(baseUrl, 'docs', 'stm32') + '#memory-hierarchy'}>
                    Flash, SRAM, and memory hierarchy
                  </a>
                </li>
              </ul>
            </div>
            <div class="article-footer">
              <div class="tags">
                <span class="tag tag-purple">ARM</span>
                <span class="tag tag-pink">Microcontrollers</span>
              </div>
              <a href={joinPath(baseUrl, 'docs', 'stm32')} class="btn btn-primary-purple btn-sm">Read Article</a>
            </div>
          </div>

          <!-- RTOS -->
          <div class="article-card article-card-teal">
            <div class="article-top">
              <h3 class="article-title">RTOS vs Bare Metal Firmware: Choosing the Right Approach</h3>
              <p class="article-desc">Comparing Real-Time Operating Systems and Bare Metal programming for embedded systems</p>
              <ul class="section-preview">
                <li>
                  <a href={joinPath(baseUrl, 'docs', 'rtos-baremetal') + '#what-is-rtos'}>
                    What RTOS is and how scheduling works
                  </a>
                </li>
                <li>
                  <a href={joinPath(baseUrl, 'docs', 'rtos-baremetal') + '#what-is-bare-metal-firmware'}>
                    What bare metal programming means in practice
                  </a>
                </li>
                <li>
                  <a href={joinPath(baseUrl, 'docs', 'rtos-baremetal') + '#detailed-comparison'}>
                    Side-by-side comparison tables and decision guide
                  </a>
                </li>
              </ul>
            </div>
            <div class="article-footer">
              <div class="tags">
                <span class="tag tag-teal">RTOS</span>
                <span class="tag tag-blue">Firmware</span>
              </div>
              <a href={joinPath(baseUrl, 'docs', 'rtos-baremetal')} class="btn btn-primary-teal btn-sm">Read Article</a>
            </div>
          </div>

        </div>
      </section>

      <hr class="divider" />

      <!-- ── Case Studies & Experiments ── -->
      <section class="section">
        <h2 class="section-heading">Case Studies & Experiments</h2>

        <div class="doc-card doc-card-teal">
          <div class="doc-card-inner">
            <div class="doc-card-main">
              <h3 class="doc-title">How I Made My First Open Source Contribution With a Little Vibe Coding</h3>
              <div class="doc-meta">
                <span><strong>Project:</strong> rstdoc (Python, open source)</span>
                <span><strong>Type:</strong> Bug fix + feature addition</span>
              </div>
              <ul class="section-preview">
                <li>
                  <a href={joinPath(baseUrl, 'docs', 'open-source-contrib') + '#the-problem'}>
                    The Word → RST conversion problem slowing the team down
                  </a>
                </li>
                <li>
                  <a href={joinPath(baseUrl, 'docs', 'open-source-contrib') + '#the-gap'}>
                    The admonition gap nobody had fixed yet
                  </a>
                </li>
                <li>
                  <a href={joinPath(baseUrl, 'docs', 'open-source-contrib') + '#building-the-fix'}>
                    Building process_rst_admonitions() with AI
                  </a>
                </li>
                <li>
                  <a href={joinPath(baseUrl, 'docs', 'open-source-contrib') + '#the-pull-request'}>
                    Why the PR merged with no revisions requested
                  </a>
                </li>
              </ul>
            </div>
            <div class="doc-card-actions">
              <a href={joinPath(baseUrl, 'docs', 'open-source-contrib')} class="btn btn-primary-teal">Read Article</a>
              <a href="https://github.com/rstdoc/rstdoc/pull/2" target="_blank" class="btn btn-outline-teal-two">GitHub</a>
            </div>
          </div>
        </div>
      </section>

      <hr class="divider" />

      <!-- ── In Progress ── -->
      <section class="section">
        <h2 class="section-heading">In Progress</h2>
        <div class="in-progress-grid">
          <div class="in-progress-item">
            <span class="in-progress-dot"></span>
            <div>
              <p class="in-progress-title">Sphinx Documentation Project Walkthrough</p>
              <p class="in-progress-desc">Custom CSS theming and feedback button experiment</p>
            </div>
          </div>
          <div class="in-progress-item">
            <span class="in-progress-dot"></span>
            <div>
              <p class="in-progress-title">How I Built This Portfolio with Astro and Claude</p>
              <p class="in-progress-desc">A complete vibecoding journey from scratch</p>
            </div>
          </div>
        </div>
      </section>

      <div class="back-link">
        <a href={baseUrl}>← Back to Home</a>
      </div>

    </div>
  </div>
</BaseLayout>

<style>
  /* ── Layout ── */
  .page-wrapper {
    display: flex;
    justify-content: center;
    padding: 6.5rem 1.5rem 4rem; /* top clears fixed navbar */
  }

  .page-card {
    max-width: 1000px;
    width: 100%;
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border-radius: 2rem;
    box-shadow: 0 25px 50px -12px rgba(139, 92, 246, 0.15);
    padding: 3.5rem 3rem;
    animation: fadeInUp 0.8s ease-out;
  }

  @keyframes fadeInUp {
    from { opacity: 0; transform: translateY(30px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  /* ── Header ── */
  .page-title {
    font-family: 'Playfair Display', serif;
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 700;
    color: #1e293b;
    margin-bottom: 0.5rem;
    line-height: 1.15;
  }

  .page-subtitle {
    font-size: 0.875rem;
    color: #64748b;
    line-height: 1.65;
    margin-bottom: 1.5rem;
  }

  .divider {
    border: none;
    border-top: 1px solid #e2e8f0;
    margin: 1.75rem 0;
  }

  /* ── Sections ── */
  .section { margin-bottom: 0; }

  .section-heading {
    font-family: 'Playfair Display', serif;
    font-size: 1.25rem;
    font-weight: 700;
    color: #1e293b;
    margin-bottom: 1rem;
  }

  /* ── Featured doc cards (horizontal layout) ── */
  .doc-card {
    border-radius: 1rem;
    border: 1px solid transparent;
    margin-bottom: 0.75rem;
    overflow: hidden;
  }

  .doc-card-teal   { background: linear-gradient(135deg, #f0fdf4, #e0f2fe); border-color: #99f6e4; }
  .doc-card-purple { background: linear-gradient(135deg, #faf5ff, #f0e6ff); border-color: #ddd6fe; }

  .doc-card-inner {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1.5rem;
    padding: 1.25rem 1.5rem;
  }

  .doc-card-main { flex: 1; }

  .doc-title {
    font-family: 'Playfair Display', serif;
    font-size: 1.05rem;
    font-weight: 700;
    color: #1e293b;
    margin-bottom: 0.4rem;
    line-height: 1.3;
  }

  .doc-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
    font-size: 0.775rem;
    color: #475569;
    margin-bottom: 0.7rem;
  }

  .doc-meta strong { color: #1e293b; }

  .doc-card-actions {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    flex-shrink: 0;
    align-items: flex-end;
    padding-top: 0.15rem;
  }

  /* ── Section preview (Option A + C) ── */
  .section-preview {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .section-preview li {
    font-size: 0.775rem;
    color: #475569;
    display: flex;
    align-items: baseline;
    gap: 0.35rem;
  }

  .section-preview li::before {
    content: '›';
    color: #0d9488;
    font-weight: 700;
    flex-shrink: 0;
  }

  .section-preview a {
    color: #475569;
    text-decoration: none;
    transition: color 0.15s;
  }

  .section-preview a:hover {
    color: #0d9488;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  /* ── Technical Articles grid ── */
  .articles-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 0.75rem;
  }

  .article-card {
    border-radius: 1rem;
    border: 1px solid transparent;
    padding: 1.1rem 1.25rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .article-card-teal   { background: linear-gradient(135deg, #f0fdf4, #e0f2fe); border-color: #99f6e4; }
  .article-card-purple { background: linear-gradient(135deg, #faf5ff, #f0e6ff); border-color: #ddd6fe; }

  .article-top { display: flex; flex-direction: column; gap: 0.3rem; }

  .article-title {
    font-family: 'Playfair Display', serif;
    font-size: 0.95rem;
    font-weight: 700;
    color: #1e293b;
    line-height: 1.35;
  }

  .article-desc {
    font-size: 0.775rem;
    color: #64748b;
    line-height: 1.5;
  }

  .article-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    flex-wrap: wrap;
    padding-top: 0.5rem;
    border-top: 1px solid rgba(0,0,0,0.05);
  }

  .tags { display: flex; gap: 0.35rem; flex-wrap: wrap; }

  .tag {
    font-size: 0.7rem;
    font-weight: 500;
    padding: 0.2rem 0.6rem;
    border-radius: 99px;
  }

  .tag-teal   { background: #ccfbf1; color: #0f766e; }
  .tag-blue   { background: #dbeafe; color: #1d4ed8; }
  .tag-purple { background: #ede9fe; color: #6d28d9; }
  .tag-pink   { background: #fce7f3; color: #be185d; }

  /* ── Buttons ── */
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.8rem;
    font-weight: 600;
    padding: 0.5rem 1.1rem;
    border-radius: 99px;
    text-decoration: none;
    transition: opacity 0.15s, transform 0.15s;
    white-space: nowrap;
    cursor: pointer;
  }

  .btn:hover { opacity: 0.88; transform: translateY(-1px); }
  .btn-sm { padding: 0.35rem 0.85rem; font-size: 0.75rem; }

  .btn-primary-teal   { background: #0d9488; color: #fff; }
  .btn-primary-purple { background: #7c3aed; color: #fff; }

  .btn-outline-teal {
    background: transparent;
    color: #0d9488;
    border: 1.5px solid #0d9488;
    padding: 0.43rem 1.61rem;
  }

  .btn-outline-teal-two {
    background: transparent;
    color: #0d9488;
    border: 1.5px solid #0d9488;
    padding: 0.43rem 2.0rem;
  }

  /* ── In Progress ── */
  .in-progress-grid {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .in-progress-item {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 0.75rem;
    padding: 0.7rem 1rem;
  }

  .in-progress-dot {
    width: 8px;
    height: 8px;
    background: #f59e0b;
    border-radius: 99px;
    flex-shrink: 0;
    margin-top: 0.3rem;
  }

  .in-progress-title {
    font-size: 0.825rem;
    font-weight: 600;
    color: #1e293b;
    margin-bottom: 0.1rem;
  }

  .in-progress-desc {
    font-size: 0.75rem;
    color: #64748b;
  }

  /* ── Back link ── */
  .back-link { margin-top: 1.5rem; }

  .back-link a {
    font-size: 0.85rem;
    color: #0d9488;
    font-weight: 500;
    text-decoration: none;
  }

  .back-link a:hover { text-decoration: underline; }

  /* ── Responsive ── */
  @media (max-width: 640px) {
    .page-card { padding: 1.75rem 1.25rem; border-radius: 1.5rem; }

    .doc-card-inner {
      flex-direction: column;
      gap: 1rem;
    }

    .doc-card-actions {
      flex-direction: row;
      align-items: center;
    }

    .articles-grid { grid-template-columns: 1fr; }
  }
</style>