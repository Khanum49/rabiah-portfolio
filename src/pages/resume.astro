                </div>
                <div class="cv-lang-item">
                  <span class="cv-lang-name">Finnish</span>
                  <span class="cv-lang-level">Elementary</span>
                </div>
              </div>
            </section>

          </div>

          <!-- Technical Expertise -->
          <section class="cv-section">
            <h2 class="cv-section-title">Technical Expertise</h2>
            <div class="cv-skills-grid">
              <div class="cv-skill-group">
                <p class="cv-skill-group-title">Documentation & APIs</p>
                <div class="cv-tags">
                  <span class="tag">Sphinx (RST)</span>
                  <span class="tag">Confluence</span>
                  <span class="tag">Docs-as-Code</span>
                  <span class="tag">GitHub</span>
                  <span class="tag">VS Code</span>
                  <span class="tag">Postman</span>
                  <span class="tag">REST APIs</span>
                  <span class="tag">Draw.io</span>
                  <span class="tag">LucidChart</span>
                  <span class="tag">Canva</span>
                </div>
              </div>
              <div class="cv-skill-group">
                <p class="cv-skill-group-title">Automation & Web</p>
                <div class="cv-tags">
                  <span class="tag">Python</span>
