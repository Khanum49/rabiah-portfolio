              <div class="cv-skill-group">
                <p class="cv-skill-group-title">Domain Knowledge</p>
                <div class="cv-tags">
                  <span class="tag">Multi-cloud Networking</span>
                  <span class="tag">Azure VNets</span>
                  <span class="tag">AWS</span>
                  <span class="tag">GCP</span>
                  <span class="tag">TCP/IP</span>
                  <span class="tag">IPv4/IPv6</span>
                  <span class="tag">DNS & DHCP</span>
                  <span class="tag">Neo4j</span>
                  <span class="tag">LLMs</span>
                  <span class="tag">AI workflows</span>
                </div>
              </div>
            </div>
          </section>

          <!-- Certificates -->
          <section class="cv-section">
            <h2 class="cv-section-title">Certificates & Training</h2>
            <div class="cv-cert-grid">
              <div class="cv-cert-item">
                <span class="cv-cert-name">Authoring API Documentation</span>
                <span class="cv-cert-org">Postman Academy · June 2026</span>
              </div>
              <div class="cv-cert-item">
                <span class="cv-cert-name">API Documentation Path</span>
