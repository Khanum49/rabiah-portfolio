                </div>
                <div class="cv-lang-item">
                  <span class="cv-lang-name">Urdu</span>
                  <span class="cv-lang-level">Native or bilingual</span>
                </div>
                <div class="cv-lang-item">
                  <span class="cv-lang-name">Punjabi</span>
