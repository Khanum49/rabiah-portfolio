---
// src/pages/resume.astro
import BaseLayout from "../layouts/BaseLayout.astro";

const joinPath = (...parts: string[]) => {
  return parts
    .map((part, index) => {
      if (index > 0 && part.startsWith('/')) part = part.slice(1);
      if (index < parts.length - 1 && part.endsWith('/')) part = part.slice(0, -1);
      return part;
    })
    .join('/');
};

const baseUrl = import.meta.env.BASE_URL;
---

<BaseLayout title="Resume — Rabiah Khanum">
  <div class="resume-wrapper">
    <div class="resume-container">

      <!-- Top bar: back link + download -->
      <div class="resume-topbar">
        <a href={joinPath(baseUrl, 'about')} class="back-link">
