</BaseLayout>

<style>
  .resume-wrapper {
    min-height: 100vh;
    padding: 6rem 1.25rem 3rem;
  }

  .resume-container {
    max-width: 900px;
    margin: 0 auto;
  }

  /* ── Top bar ── */
  .resume-topbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.25rem;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: #0d9488;
    font-size: 0.875rem;
    font-weight: 500;
    text-decoration: none;
    transition: opacity 0.2s;
  }
  .back-link:hover { opacity: 0.75; }

  .download-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: #0d9488;
    color: #fff;
    font-size: 0.875rem;
    font-weight: 600;
    padding: 0.55rem 1.1rem;
    border-radius: 99px;
    text-decoration: none;
    transition: background 0.2s, transform 0.15s;
  }
  .download-btn:hover {
    background: #0f766e;
    transform: translateY(-1px);
  }

  /* ── CV Card ── */
  .cv-card {
    background: rgba(255,255,255,0.93);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border-radius: 1.5rem;
    box-shadow: 0 8px 48px rgba(13,148,136,0.07), 0 2px 12px rgba(0,0,0,0.05);
    overflow: hidden;
  }

  /* ── Header ── */
  .cv-header {
    background: linear-gradient(135deg, #0d9488 0%, #0891b2 100%);
    padding: 2.5rem 2.5rem 2rem;
    color: #fff;
  }

  .cv-name {
    font-family: 'Playfair Display', serif;
    font-size: clamp(1.9rem, 5vw, 2.75rem);
    font-weight: 700;
    line-height: 1.1;
    margin-bottom: 0.35rem;
  }

  .cv-title {
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    opacity: 0.85;
    margin-bottom: 1rem;
  }

  .cv-contact-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.8rem;
    opacity: 0.9;
  }

  .cv-contact-row a {
    color: #fff;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .dot { opacity: 0.5; }

  /* ── Body ── */
  .cv-body {
    padding: 2rem 2.5rem 2.5rem;
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  /* ── Section ── */
  .cv-section { display: flex; flex-direction: column; gap: 1rem; }

  .cv-section-title {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #0d9488;
    padding-bottom: 0.5rem;
    border-bottom: 1.5px solid #ccfbf1;
  }

  .cv-prose {
    font-size: 0.875rem;
    color: #475569;
    line-height: 1.75;
  }

  /* ── Job ── */
  .cv-job { display: flex; flex-direction: column; gap: 0.6rem; }
  .cv-job + .cv-job { padding-top: 1.25rem; border-top: 1px solid #f1f5f9; }

  .cv-job-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.25rem;
  }

  .cv-job-title {
    font-size: 0.925rem;
    font-weight: 700;
    color: #1e293b;
  }

  .cv-job-sep { color: #94a3b8; margin: 0 0.25rem; }

  .cv-job-company {
    font-size: 0.9rem;
    font-weight: 600;
    color: #0d9488;
    text-decoration: none;
  }
  .cv-job-company:hover { text-decoration: underline; }

  .cv-job-company-plain {
    font-size: 0.9rem;
    font-weight: 600;
    color: #334155;
  }

  .cv-job-date {
    font-size: 0.775rem;
    color: #94a3b8;
    white-space: nowrap;
    font-weight: 500;
  }

  .cv-bullets {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    padding-left: 0;
  }

  .cv-bullets li {
    font-size: 0.84rem;
    color: #475569;
    line-height: 1.65;
    padding-left: 1.1rem;
    position: relative;
  }

  .cv-bullets li::before {
    content: '–';
    position: absolute;
    left: 0;
    color: #0d9488;
    font-weight: 600;
  }

  .cv-bullets strong { color: #1e293b; font-weight: 600; }

  /* ── Two column ── */
  .cv-two-col {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
  }

  @media (max-width: 600px) {
    .cv-two-col { grid-template-columns: 1fr; }
  }

  /* ── Education ── */
  .cv-edu-item { margin-bottom: 0.9rem; }
  .cv-edu-item:last-child { margin-bottom: 0; }

  .cv-edu-degree {
    font-size: 0.875rem;
    font-weight: 600;
    color: #1e293b;
    margin-bottom: 0.1rem;
  }

  .cv-edu-school {
    font-size: 0.8rem;
    color: #475569;
    margin-bottom: 0.1rem;
  }

  .cv-edu-meta {
    font-size: 0.75rem;
    color: #94a3b8;
  }

  /* ── Languages ── */
  .cv-lang-list { display: flex; flex-direction: column; gap: 0.6rem; }

  .cv-lang-item {
    display: flex;
    flex-direction: column;
    gap: 0.05rem;
  }

  .cv-lang-name {
    font-size: 0.875rem;
    font-weight: 600;
    color: #1e293b;
  }

  .cv-lang-level {
    font-size: 0.775rem;
    color: #64748b;
  }

  /* ── Skills ── */
  .cv-skills-grid {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .cv-skill-group-title {
    font-size: 0.775rem;
    font-weight: 600;
    color: #334155;
    margin-bottom: 0.5rem;
  }

  .cv-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .tag {
    font-size: 0.75rem;
    font-weight: 500;
    padding: 0.25rem 0.65rem;
    border-radius: 99px;
    background: #f0fdf4;
    color: #0f766e;
    border: 1px solid #99f6e4;
  }

  /* ── Certificates ── */
  .cv-cert-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
  }

  @media (max-width: 600px) {
    .cv-cert-grid { grid-template-columns: 1fr; }
  }

  .cv-cert-item {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    padding: 0.75rem;
    background: #f8fafc;
    border-radius: 0.5rem;
    border: 1px solid #e2e8f0;
  }

  .cv-cert-name {
    font-size: 0.8rem;
    font-weight: 600;
    color: #1e293b;
  }

  .cv-cert-org {
    font-size: 0.73rem;
    color: #64748b;
  }

  /* ── Mobile card padding ── */
  @media (max-width: 600px) {
    .cv-header { padding: 2rem 1.5rem 1.5rem; }
    .cv-body { padding: 1.5rem 1.5rem 2rem; }
  }

  /* ── Bottom CTA ── */
  .bottom-cta {
    display: flex;
    justify-content: center;
    padding: 1.75rem 0 0.5rem;
  }

  .download-btn-lg {
    font-size: 0.95rem;
    padding: 0.75rem 1.75rem;
    border-radius: 99px;
  }

  /* ── Animation ── */
  @keyframes fadeInUp {
    from { opacity: 0; transform: translateY(28px); }
    to   { opacity: 1; transform: translateY(0); }
  }
</style>