                <span class="cv-cert-name">Aspire Leaders Program</span>
                <span class="cv-cert-org">Harvard Aspire Institute · Nov 2024</span>
              </div>
              <div class="cv-cert-item">
                <span class="cv-cert-name">Microsoft Azure Course</span>
                <span class="cv-cert-org">Great Learning Academy · Aug 2024</span>
              </div>
              <div class="cv-cert-item">
                <span class="cv-cert-name">Huawei Seeds for the Future — Cloud Computing</span>
                <span class="cv-cert-org">Huawei · Aug 2024</span>
              </div>
              <div class="cv-cert-item">
                <span class="cv-cert-name">Networking Basics</span>
