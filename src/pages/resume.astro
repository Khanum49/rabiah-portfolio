            <path fill-rule="evenodd" d="M17 10a.75.75 0 0 1-.75.75H6.612l3.158 3.96a.75.75 0 1 1-1.04 1.08l-4.5-4.25a.75.75 0 0 1 0-1.08l4.5-4.25a.75.75 0 1 1 1.04 1.08L6.612 9.25H16.25A.75.75 0 0 1 17 10Z" clip-rule="evenodd"/>
          </svg>
          Back to About Me
        </a>
        <a href={`${baseUrl}cv/CV_Rabiah_Khanum_Main_.pdf`} download class="download-btn">
