---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Writing - Rabiah Khanum">
  <div class="page-wrapper">

    <!-- Page header -->
    <div class="page-header">
      <h1 class="page-title">Blog</h1>
      <p class="page-subtitle">Reflections on books, creativity, and the art of thoughtful reading</p>
    </div>

    <!-- Cards -->
    <div class="cards-list">

      <!-- Card 1: STVY Published Feature -->
      <article class="card">
        <div class="card-accent card-accent-green"></div>
        <div class="card-body">
          <div class="card-tag card-tag-green">
            <svg class="tag-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"/></svg>
            <span>Published Feature</span>
          </div>
          <h2 class="card-title">Wired to Write: A Pakistani Engineer's Journey into Tech Writing</h2>
          <p class="card-desc">My story published by the Finnish Technical Communication Society (Suomen teknisen viestinnän yhdistys STVY) as part of their global tech writer spotlight series. It reflects on my experience entering the field during the AI boom, building docs-as-code pipelines, and finding international community when local networks don't yet exist.</p>
          <div class="card-footer">
            <span class="card-meta">Published on STVY • June 1, 2026 • 5 min read</span>
            <a href="https://stvy.fi/en/rabiah-khanum-wired-to-write-a-pakistani-engineers-journey-into-tech-writing-2/" target="_blank" rel="noopener noreferrer" class="card-btn card-btn-green">
              Read Full Feature
              <svg class="btn-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
            </a>
          </div>
        </div>
      </article>

      <!-- Card 2: Goodreads Review -->
      <article class="card">
        <div class="card-accent card-accent-yellow"></div>
        <div class="card-body">
          <div class="card-tag card-tag-yellow">
            <svg class="tag-icon" fill="currentColor" viewBox="0 0 24 24"><path d="M17.346.026c.422-.083.859.037 1.179.325.346.284.55.705.557 1.153-.023.457-.247.88-.612 1.156l-2.182 1.748a.601.601 0 0 0-.255.43.52.52 0 0 0 .11.424 5.886 5.886 0 0 1 .832 6.58c-1.394 2.79-4.503 3.99-7.501 2.927a.792.792 0 0 0-.499-.01c-.224.07-.303.18-.453.383l-.014.02-.941 1.254s-.792.985.457.935c3.027-.119 3.817-.119 5.439-.01 2.641.18 3.806 1.903 3.806 3.275 0 1.623-1.036 3.383-3.809 3.383a117.46 117.46 0 0 0-5.517-.03c-.31.005-.597.013-.835.02-.228.006-.41.011-.52.011-.712 0-1.648-.186-1.66-1.068-.008-.729.624-1.12 1.11-1.172.43-.045.815.007 1.24.064.252.034.518.07.815.088.185.011.366.025.552.038.53.038 1.102.08 1.926.087.427.005.759.01 1.025.015.695.012.941.016 1.28-.015 1.248-.112 1.832-.61 1.832-1.376 0-.805-.584-1.264-1.698-1.414-1.564-.213-2.33-.163-3.72-.074a87.66 87.66 0 0 1-1.669.095c-.608.029-2.449.026-2.682-1.492-.053-.416-.073-1.116.807-2.325l.75-1.003c.36-.49.582-.898.053-1.559 0 0-.39-.468-.52-.638-1.215-1.587-1.512-4.08-.448-6.114 1.577-3.011 5.4-4.26 8.37-2.581.253.143.438.203.655.163.201-.032.27-.167.363-.344.02-.04.042-.082.067-.126.004-.01.241-.465.535-1.028l.734-1.41a1.493 1.493 0 0 1 1.041-.785ZM9.193 13.243c1.854.903 3.912.208 5.254-2.47 1.352-2.699.827-5.11-1.041-6.023C10.918 3.537 8.81 5.831 8.017 7.41c-1.355 2.698-.717 4.886 1.147 5.818Z"/></svg>
            <span>Goodreads Book Review</span>
          </div>
          <h2 class="card-title">Detailed Book Review of "Take it Back" by Kia Abdullah</h2>
          <p class="card-desc">A psychological thriller that left me reeling, and disagreeing. My 2-star review of Kia Abdullah's <em>Take it Back</em>, written as a South Asian reader with family ties to Britain.</p>
          <div class="card-footer">
            <span class="card-meta">Published on Goodreads • April 29, 2026 • 10 min read</span>
            <a href={`${import.meta.env.BASE_URL}goodreads-review`} class="card-btn card-btn-yellow">
              Read Full Review
              <svg class="btn-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </a>
          </div>
        </div>
      </article>

      <!-- Card 3: All This Brain -->
      <article class="card">
        <div class="card-accent card-accent-blue"></div>
        <div class="card-body">
          <div class="card-tag">
            <svg class="tag-icon" fill="currentColor" viewBox="0 0 24 24"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
            <span>LinkedIn Article</span>
          </div>
          <h2 class="card-title">All This Brain and We Don't Even Use It to Think Words?</h2>
          <p class="card-desc">What happens to our thinking when AI does the writing for us? Reflecting on Tom Johnson's piece on Bakhtin and model collapse, and why the struggle of a messy first draft is worth protecting.</p>
          <div class="card-footer">
            <span class="card-meta">Published on LinkedIn • February 26, 2026 • 10 min read</span>
            <a href="https://www.linkedin.com/pulse/all-brain-we-dont-even-use-think-words-rabiah-khanum-wzvzf/" target="_blank" rel="noopener noreferrer" class="card-btn card-btn-blue">
              Read Full Article
              <svg class="btn-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
            </a>
          </div>
        </div>
      </article>

      <!-- Card 4: Why We Can't Stop Ignoring Books -->
      <article class="card">
        <div class="card-accent card-accent-teal"></div>
        <div class="card-body">
          <div class="card-tag">
            <svg class="tag-icon" fill="currentColor" viewBox="0 0 24 24"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
            <span>LinkedIn Article</span>
          </div>
          <h2 class="card-title">Why We Can't Stop Ignoring Books</h2>
          <p class="card-desc">I found Niall Ferguson's essay on books and barbarism through an Instagram reel, and actually read it instead of summarizing it with ChatGPT. Here's what it stirred up.</p>
          <div class="card-footer">
            <span class="card-meta">Published on LinkedIn • January 15, 2026 • 5 min read</span>
            <a href="https://www.linkedin.com/pulse/why-we-cant-stop-ignoring-books-rabiah-khanum-y4aqf/?trackingId=rCTd2uQNAjgV4kOlSDmV9A%3D%3D" target="_blank" rel="noopener noreferrer" class="card-btn card-btn-teal">
              Read Full Article
              <svg class="btn-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
            </a>
          </div>
        </div>
      </article>

      <!-- Card 5: 2025 Lookback -->
      <article class="card">
        <div class="card-accent card-accent-blue"></div>
        <div class="card-body">
          <div class="card-tag">
            <svg class="tag-icon" fill="currentColor" viewBox="0 0 24 24"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
            <span>LinkedIn Post</span>
          </div>
          <h2 class="card-title">A Lookback at my 2025 Journey</h2>
          <p class="card-desc">A reflection on my first full year after graduation, the skills I built, and the perspectives that changed me.</p>
          <div class="card-footer">
            <span class="card-meta">Posted on Linked • December 31, 2025 • 5 min read</span>
            <a href={`${import.meta.env.BASE_URL}2025-lookback`} class="card-btn card-btn-blue">
              Read Full Post
              <svg class="btn-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </a>
          </div>
        </div>
      </article>


      <!-- Card 3: Dream a Fiction -->
      <article class="card">
        <div class="card-accent card-accent-purple"></div>
        <div class="card-body">
          <div class="card-tag card-tag-purple">
            <svg class="tag-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"/></svg>
            <span>Fiction Writing</span>
          </div>
          <h2 class="card-title">Dream a Fiction</h2>
          <p class="card-desc">A friend was collecting writing samples to understand how different people write. I wrote this short story in a few minutes, letting the words flow without overthinking.</p>
          <div class="card-footer">
            <span class="card-meta">Creative Writing Sample • Stream of Consciousness • 5 min read</span>
            <a href={`${import.meta.env.BASE_URL}dream-a-fiction`} class="card-btn card-btn-purple">
              Read Full Story
              <svg class="btn-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </a>
          </div>
        </div>
      </article>
    </div>

    <!-- On Writing footer -->
    <div class="philosophy">
      <h3 class="philosophy-title">On Writing</h3>
      <p class="philosophy-text">
        Whether I'm documenting complex technical systems or letting fiction pour out in a few minutes, writing has always been about making sense of the world, and leaving something behind that outlasts the moment.
      </p>
      <p class="philosophy-sub">
        Good writing, technical or creative, makes the complex accessible and the familiar meaningful.
      </p>
    </div>

  </div>
</BaseLayout>

<style>
  .page-wrapper {
    max-width: 960px;
    margin: 0 auto;
    padding: 4.5rem 1.5rem 4rem;
  }

  /* Header */
  .page-header {
    text-align: center;
    margin-bottom: 2.5rem;
  }

  .page-title {
    font-family: 'Playfair Display', serif;
    font-size: clamp(2.25rem, 5vw, 3.5rem);
    font-weight: 700;
    color: #1e293b;
    margin-bottom: 0.5rem;
  }

  .page-subtitle {
    font-size: 1rem;
    color: #64748b;
  }

  /* Cards list */
  .cards-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 2rem;
  }

  /* Card */
  .card {
    background: #fff;
    border-radius: 1rem;
    border: 1px solid #e2e8f0;
    box-shadow: 0 2px 12px rgba(0,0,0,0.05);
    overflow: hidden;
    transition: box-shadow 0.2s, transform 0.2s;
  }

  .card:hover {
    box-shadow: 0 6px 24px rgba(0,0,0,0.09);
    transform: translateY(-2px);
  }

  /* Stagger animation */
  @keyframes fadeInUp {
    from { opacity: 0; transform: translateY(24px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  .card { animation: fadeInUp 0.7s ease-out both; }
  .card:nth-child(1) { animation-delay: 0s; }
  .card:nth-child(2) { animation-delay: 0.1s; }
  .card:nth-child(3) { animation-delay: 0.2s; }
  .card:nth-child(4) { animation-delay: 0.3s; }
  .card:nth-child(5) { animation-delay: 0.4s; }

  /* Accent stripe */
  .card-accent        { height: 3px; }
  .card-accent-green  { background: linear-gradient(to right, #059669, #34d399); }
  .card-accent-blue   { background: linear-gradient(to right, #1e40af, #60a5fa); }
  .card-accent-teal   { background: linear-gradient(to right, #0d9488, #38bdf8); }
  .card-accent-purple { background: linear-gradient(to right, #7c3aed, #ec4899); }
  .card-accent-yellow { background: linear-gradient(to right, #f59e0b, #b45309); }

  .card-body {
    padding: 1.5rem;
  }

  /* Tag row */
  .card-tag {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: #1e40af;
    margin-bottom: 0.6rem;
  }

  .card-tag-green  { color: #065f46; }
  .card-tag-purple { color: #7c3aed; }
  .card-tag-yellow { color: #92400e; }

  .tag-icon {
    width: 15px;
    height: 15px;
    flex-shrink: 0;
  }

  /* Title */
  .card-title {
    font-family: 'Playfair Display', serif;
    font-size: clamp(1.1rem, 2.5vw, 1.35rem);
    font-weight: 700;
    color: #1e293b;
    line-height: 1.3;
    margin-bottom: 0.5rem;
  }

  /* Description */
  .card-desc {
    font-size: 0.9rem;
    color: #475569;
    line-height: 1.65;
    margin-bottom: 1rem;
  }

  /* Footer */
  .card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 0.875rem;
    border-top: 1px solid #f1f5f9;
    flex-wrap: wrap;
  }

  .card-meta {
    font-size: 0.75rem;
    color: #94a3b8;
  }

  /* Buttons */
  .card-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.8rem;
    font-weight: 500;
    text-decoration: none;
    padding: 0.45rem 1rem;
    border-radius: 0.5rem;
    color: #fff;
    white-space: nowrap;
    transition: opacity 0.2s, transform 0.15s;
  }

  .card-btn:hover {
    opacity: 0.88;
    transform: scale(1.02);
  }

  .card-btn-green  { background: linear-gradient(to right, #037752, #0eab71); }
  .card-btn-blue   { background: linear-gradient(to right, #1e40af, #3b82f6); }
  .card-btn-teal   { background: linear-gradient(to right, #0d9488, #0ea5e9); }
  .card-btn-purple { background: linear-gradient(to right, #7c3aed, #ec4899); }
  .card-btn-yellow { background: linear-gradient(to right, #f59e0b, #b45309); }

  .btn-icon {
    width: 13px;
    height: 13px;
  }

  /* On Writing */
  .philosophy {
    background: linear-gradient(135deg, #f0fdf4, #eff6ff);
    border-radius: 1rem;
    padding: 2rem;
    text-align: center;
  }

  .philosophy-title {
    font-family: 'Playfair Display', serif;
    font-size: 1.25rem;
    font-weight: 700;
    color: #1e293b;
    margin-bottom: 0.75rem;
  }

  .philosophy-text {
    font-size: 0.95rem;
    color: #475569;
    max-width: 600px;
    margin: 0 auto 0.5rem;
    line-height: 1.7;
  }

  .philosophy-sub {
    font-size: 0.875rem;
    color: #64748b;
    font-style: italic;
    max-width: 500px;
    margin: 0 auto;
    line-height: 1.6;
  }

  /* Mobile */
  @media (max-width: 480px) {
    .card-footer {
      flex-direction: column;
      align-items: flex-start;
    }

    .card-btn {
      width: 100%;
      justify-content: center;
    }
  }

  .card-actions {
  display: flex;
  gap: 0.75rem;
  align-items: center;
}

.card-btn-primary {
  background: linear-gradient(135deg, #2563eb, #3b82f6);
  color: white;
}

.card-btn-primary:hover {
  transform: translateY(-2px);
}

.card-btn-secondary {
  background: white;
  color: #2563eb;
  border: 1px solid #cbd5e1;
}

.card-btn-secondary:hover {
  background: #f8fafc;
}
</style>