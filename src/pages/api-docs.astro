    <span class="text-teal-300">"message"</span>: <span class="text-yellow-300">"Field 'chip' is required."</span>
  &#125;
&#125;</pre>
                  </div>
                </div>
              </div>

              <div class="bg-gradient-to-br from-teal-50 to-blue-50 rounded-xl border border-teal-200 p-5">
                <div class="flex items-center justify-between mb-3">
                  <div>
                    <h4 class="font-semibold text-slate-800 text-sm">Try it live</h4>
                    <p class="text-xs text-slate-500 mt-0.5">POSTs to JSONPlaceholder and remaps the response. No device is created; the mock API echoes a response as if it were.</p>
                  </div>
                  <button id="try-post-device" class="try-btn px-4 py-2 bg-teal-600 hover:bg-teal-700 text-white text-xs font-semibold rounded-lg transition-colors flex items-center gap-2">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                    Run
                  </button>
                </div>
                <div id="result-post-device" class="hidden bg-slate-900 rounded-lg p-4 overflow-x-auto">
                  <pre class="text-xs font-mono text-slate-100 result-text"></pre>
                </div>
              </div>
            </div>
          </section>

          <!-- Reference divider -->
          <div class="flex items-center gap-3 pt-2">
            <span class="text-xs font-semibold text-slate-400 uppercase tracking-widest">Reference</span>
            <div class="flex-1 h-px bg-slate-200"></div>
          </div>

          <!-- 7. Error Codes -->
          <section id="errors" class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
            <div class="px-6 py-5 border-b border-slate-100">
              <h2 class="text-xl font-bold text-slate-900" style="font-family: 'Playfair Display', serif;">Error Codes</h2>
            </div>
            <div class="px-6 py-6 space-y-5 text-sm">
              <p class="text-slate-700 leading-relaxed">
                The API uses standard HTTP status codes. When a request fails, the response body always includes an <code class="font-mono bg-slate-100 px-1.5 py-0.5 rounded text-slate-800">error</code> object with a machine-readable <code class="font-mono bg-slate-100 px-1.5 py-0.5 rounded text-slate-800">code</code> and a human-readable <code class="font-mono bg-slate-100 px-1.5 py-0.5 rounded text-slate-800">message</code> explaining what went wrong.
              </p>
              <div class="bg-slate-900 rounded-xl overflow-hidden">
                <div class="flex items-center justify-between px-3 py-1.5 bg-slate-800">
                  <span class="text-xs text-slate-400 font-mono">Error response shape</span>
                  <button class="copy-btn-icon p-1 rounded text-slate-400 hover:text-white transition-colors" data-target="error-shape" title="Copy">
                    <svg class="copy-icon w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
                    <svg class="check-icon w-3.5 h-3.5 hidden text-teal-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
                  </button>
                </div>
                <pre id="error-shape" class="px-4 py-3 text-sm font-mono text-slate-100">&#123;
  <span class="text-teal-300">"error"</span>: &#123;
    <span class="text-teal-300">"code"</span>: <span class="text-yellow-300">"not_found"</span>,
    <span class="text-teal-300">"message"</span>: <span class="text-yellow-300">"Device dev_000001 does not exist in this project."</span>
  &#125;
&#125;</pre>
              </div>
              <div class="border border-slate-200 rounded-xl overflow-hidden">
                <table class="w-full text-xs">
                  <thead class="bg-slate-50">
                    <tr>
                      <th class="text-left px-4 py-3 font-semibold text-slate-600">HTTP Status</th>
                      <th class="text-left px-4 py-3 font-semibold text-slate-600">Error Code</th>
                      <th class="text-left px-4 py-3 font-semibold text-slate-600">Meaning</th>
                      <th class="text-left px-4 py-3 font-semibold text-slate-600">Common Cause</th>
                    </tr>
                  </thead>
                  <tbody class="divide-y divide-slate-100">
                    <tr>
                      <td class="px-4 py-3"><span class="font-mono font-bold text-emerald-600">200</span></td>
                      <td class="px-4 py-3 font-mono text-slate-700">-</td>
                      <td class="px-4 py-3 text-slate-600">Request succeeded</td>
                      <td class="px-4 py-3 text-slate-500">-</td>
                    </tr>
                    <tr>
                      <td class="px-4 py-3"><span class="font-mono font-bold text-emerald-600">201</span></td>
                      <td class="px-4 py-3 font-mono text-slate-700">-</td>
                      <td class="px-4 py-3 text-slate-600">Resource created</td>
                      <td class="px-4 py-3 text-slate-500">Successful POST</td>
                    </tr>
                    <tr>
                      <td class="px-4 py-3"><span class="font-mono font-bold text-amber-500">400</span></td>
                      <td class="px-4 py-3 font-mono text-slate-700">bad_request</td>
                      <td class="px-4 py-3 text-slate-600">Malformed request</td>
                      <td class="px-4 py-3 text-slate-500">Missing required field, invalid JSON</td>
                    </tr>
                    <tr>
                      <td class="px-4 py-3"><span class="font-mono font-bold text-amber-500">401</span></td>
                      <td class="px-4 py-3 font-mono text-slate-700">unauthorized</td>
                      <td class="px-4 py-3 text-slate-600">Authentication failed</td>
                      <td class="px-4 py-3 text-slate-500">Missing, expired, or invalid API token</td>
                    </tr>
                    <tr>
                      <td class="px-4 py-3"><span class="font-mono font-bold text-amber-500">404</span></td>
                      <td class="px-4 py-3 font-mono text-slate-700">not_found</td>
                      <td class="px-4 py-3 text-slate-600">Resource does not exist</td>
                      <td class="px-4 py-3 text-slate-500">Invalid device ID in path</td>
                    </tr>
                    <tr>
                      <td class="px-4 py-3"><span class="font-mono font-bold text-red-500">429</span></td>
                      <td class="px-4 py-3 font-mono text-slate-700">rate_limited</td>
                      <td class="px-4 py-3 text-slate-600">Too many requests</td>
                      <td class="px-4 py-3 text-slate-500">Exceeded 1,000 requests/hour. Retry after the <code class="bg-slate-100 px-1 rounded">Retry-After</code> header value.</td>
                    </tr>
                    <tr>
                      <td class="px-4 py-3"><span class="font-mono font-bold text-red-500">500</span></td>
                      <td class="px-4 py-3 font-mono text-slate-700">server_error</td>
                      <td class="px-4 py-3 text-slate-600">Internal server error</td>
                      <td class="px-4 py-3 text-slate-500">Not your fault. Retry with exponential backoff.</td>
                    </tr>
                  </tbody>
                </table>
              </div>
            </div>
          </section>

          <!-- 8. Toolchain -->
          <section id="toolchain" class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
            <div class="px-6 py-5 border-b border-slate-100">
              <h2 class="text-xl font-bold text-slate-900" style="font-family: 'Playfair Display', serif;">Toolchain</h2>
            </div>
            <div class="px-6 py-6 text-sm text-slate-700 leading-relaxed space-y-4">
              <p>This documentation sample was structured following <a href="https://academy.postman.com/authoring-api-documentation" target="_blank" class="text-teal-600 underline">Postman's API documentation course</a>, which defines four qualities that make API docs worth reading: <strong>complete</strong>, <strong>accurate</strong>, <strong>clear</strong>, and <strong>discoverable</strong>. The structure maps directly to how a Postman collection would be organised: folders as section groups, requests in reading order, and named response examples per endpoint.</p>
              <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 pt-1">
                <!-- Postman -->
                <div class="bg-slate-50 border border-slate-200 rounded-xl p-4 text-center flex flex-col items-center gap-2">
                  <img src="https://cdn.jsdelivr.net/npm/simple-icons@v11/icons/postman.svg" alt="Postman" class="w-8 h-8" style="filter: invert(48%) sepia(79%) saturate(2476%) hue-rotate(340deg) brightness(105%) contrast(97%);" />
                  <div>
                    <p class="font-semibold text-slate-800 text-xs">Postman</p>
                    <p class="text-xs text-slate-500 mt-0.5">Collection structure and docs</p>
                  </div>
                </div>
                <!-- OpenAPI / Swagger -->
                <div class="bg-slate-50 border border-slate-200 rounded-xl p-4 text-center flex flex-col items-center gap-2">
                  <img src="https://cdn.jsdelivr.net/npm/simple-icons@v11/icons/swagger.svg" alt="Swagger / OpenAPI" class="w-8 h-8" style="filter: invert(45%) sepia(90%) saturate(500%) hue-rotate(80deg) brightness(85%);" />
                  <div>
                    <p class="font-semibold text-slate-800 text-xs">OpenAPI / Swagger</p>
                    <p class="text-xs text-slate-500 mt-0.5">Spec format reference</p>
                  </div>
                </div>
                <!-- JSONPlaceholder — no brand logo, use a clean monogram -->
                <div class="bg-slate-50 border border-slate-200 rounded-xl p-4 text-center flex flex-col items-center gap-2">
                  <div class="w-8 h-8 rounded-lg bg-slate-800 flex items-center justify-center flex-shrink-0">
                    <span class="text-white font-bold font-mono" style="font-size: 11px;">&#123;&#125;</span>
                  </div>
                  <div>
                    <p class="font-semibold text-slate-800 text-xs">JSONPlaceholder</p>
                    <p class="text-xs text-slate-500 mt-0.5">Mock backend for demos</p>
                  </div>
                </div>
                <!-- Redoc / ReadMe -->
                <div class="bg-slate-50 border border-slate-200 rounded-xl p-4 text-center flex flex-col items-center gap-2">
                  <div class="w-8 h-8 rounded-full bg-gradient-to-br from-indigo-500 to-purple-600 flex items-center justify-center flex-shrink-0">
                    <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
                  </div>
                  <div>
                    <p class="font-semibold text-slate-800 text-xs">Redoc / ReadMe</p>
                    <p class="text-xs text-slate-500 mt-0.5">Rendering and publishing</p>
                  </div>
                </div>
              </div>
            </div>
          </section>

        </main>
      </div>
    </div>
  </div>

  <script>
    // ── Tab switching ──────────────────────────────────────────────
    document.querySelectorAll('.tab-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const targetId = btn.dataset.tab;
        const tabBar = btn.parentElement;
        tabBar.querySelectorAll('.tab-btn').forEach(b => {
          b.classList.remove('active-tab', 'text-white');
          b.classList.add('text-slate-400');
        });
        btn.classList.add('active-tab', 'text-white');
        btn.classList.remove('text-slate-400');
        const section = tabBar.closest('.rounded-xl');
        section.querySelectorAll('.tab-panel').forEach(p => p.classList.add('hidden'));
        document.getElementById(targetId)?.classList.remove('hidden');
        // sync copy button to active tab's pre id
        const copyBtn = tabBar.querySelector('.copy-btn-icon');
        if (copyBtn) copyBtn.dataset.target = targetId + '-code';
      });
    });

    // ── Copy icon buttons ──────────────────────────────────────────
    document.querySelectorAll('.copy-btn-icon').forEach(btn => {
      btn.addEventListener('click', () => {
        const target = document.getElementById(btn.dataset.target);
        if (!target) return;
        navigator.clipboard.writeText(target.innerText.trim()).then(() => {
          const copyIcon = btn.querySelector('.copy-icon');
          const checkIcon = btn.querySelector('.check-icon');
          copyIcon.classList.add('hidden');
          checkIcon.classList.remove('hidden');
          setTimeout(() => {
            copyIcon.classList.remove('hidden');
            checkIcon.classList.add('hidden');
          }, 1500);
        });
      });
    });

    // ── Live API demos ────────────────────────────────────────────
    async function runDemo(btnId, resultId, fetchFn) {
      const btn = document.getElementById(btnId);
      const resultBox = document.getElementById(resultId);
      const pre = resultBox.querySelector('.result-text');
      btn.disabled = true;
      btn.innerHTML = `<svg class="w-3.5 h-3.5 animate-spin" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg> Loading...`;
      resultBox.classList.remove('hidden');
      pre.textContent = 'Waiting for response...';
      try {
        const data = await fetchFn();
        pre.textContent = JSON.stringify(data, null, 2);
      } catch (e) {
        pre.textContent = `Error: ${e.message}`;
      } finally {
        btn.disabled = false;
        btn.innerHTML = `<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg> Run`;
      }
    }

    document.getElementById('try-get-devices').addEventListener('click', () =>
      runDemo('try-get-devices', 'result-get-devices', async () => {
        const res = await fetch('https://jsonplaceholder.typicode.com/posts?_limit=3');
        const raw = await res.json();
        return {
          total: 3, page: 1,
          devices: raw.map((p, i) => ({
            id: `dev_00000${i + 1}`,
            name: `sensor-node-0${i + 1}`,
            chip: ['ESP32-WROOM-32', 'STM32F407', 'ESP32-S3'][i % 3],
            firmware: '2.1.4', status: 'online',
            last_seen: new Date().toISOString()
          }))
        };
      })
    );

    document.getElementById('try-get-device').addEventListener('click', () =>
      runDemo('try-get-device', 'result-get-device', async () => {
        const res = await fetch('https://jsonplaceholder.typicode.com/posts/1');
        await res.json();
        return {
          id: 'dev_000001', name: 'sensor-node-01',
          chip: 'ESP32-WROOM-32', firmware: '2.1.4', status: 'online',
          ip_address: '192.168.1.42',
          created_at: '2025-11-03T14:20:00Z',
          last_seen: new Date().toISOString(),
          config: { telemetry_interval_s: 30, ota_enabled: true }
        };
      })
    );

    document.getElementById('try-post-device').addEventListener('click', () =>
      runDemo('try-post-device', 'result-post-device', async () => {
        const res = await fetch('https://jsonplaceholder.typicode.com/posts', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ name: 'sensor-node-02', chip: 'ESP32-WROOM-32', firmware: '2.1.4', ota_enabled: true })
        });
        await res.json();
        return {
          id: 'dev_000002', name: 'sensor-node-02',
          chip: 'ESP32-WROOM-32', firmware: '2.1.4',
          status: 'provisioning',
          created_at: new Date().toISOString(),
          ota_enabled: true
        };
      })
    );
  </script>
</BaseLayout>