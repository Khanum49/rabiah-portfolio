---
// src/pages/contact.astro
import BaseLayout from "../layouts/BaseLayout.astro";

const joinPath = (...parts: string[]) => {
  return parts
    .map((part, index) => {
      if (index > 0 && part.startsWith('/')) part = part.slice(1);
      if (index < parts.length - 1 && part.endsWith('/')) part = part.slice(0, -1);
      return part;
    })
    .join('/');
};

const baseUrl = import.meta.env.BASE_URL;
---

<BaseLayout title="Contact Me — Rabiah Khanum">
  <div class="page-wrapper">
    <div class="page-card">

      <p class="eyebrow">Let's connect</p>

      <h1 style="font-family: 'Playfair Display', serif;" class="page-title">
        Contact Me
      </h1>

      <div class="title-divider"></div>

      <div class="contact-grid">

        <!-- Left content -->
        <div class="contact-content">

          <p class="intro-text">
            Whether it's technical writing, documentation strategy, API docs,
            embedded systems, or collaboration opportunities, I'd love to hear from you.
          </p>

          <p class="intro-text">
            I'm especially interested in projects involving cloud networking,
            developer documentation, IoT systems, and docs-as-code workflows.
          </p>

          <div class="availability-card">
            <div class="availability-dot"></div>
            <div>
              <h3>Currently Open To</h3>
              <p>
                Technical writing roles, freelance documentation projects,
                open-source collaborations, and engineering-focused content work.
              </p>
            </div>
          </div>

          <div class="quick-links">
            <a
              href="mailto:rabiahkhanum2049@gmail.com"
              class="primary-btn"
            >
              Send an Email
            </a>
          </div>

        </div>

        <!-- Right side cards -->
        <div class="contact-cards">

          <div class="info-card card-teal">
            <div class="icon-wrapper">
              <svg viewBox="0 0 24 24" fill="currentColor" class="card-icon">
                <path d="M1.5 4.5A2.25 2.25 0 0 1 3.75 2.25h16.5A2.25 2.25 0 0 1 22.5 4.5v15a2.25 2.25 0 0 1-2.25 2.25H3.75A2.25 2.25 0 0 1 1.5 19.5v-15Zm2.74-.75a.75.75 0 0 0-.49 1.32l7.5 6.43a1.5 1.5 0 0 0 1.95 0l7.5-6.43a.75.75 0 0 0-.98-1.14L12 10.44 4.24 3.75Z"/>
              </svg>
            </div>

            <div>
              <h2>Email</h2>
              <p>Best for collaborations & inquiries</p>

              <a href="mailto:khanumrabiah@gmail.com">
                khanumrabiah@gmail.com
              </a>
            </div>
          </div>

          <div class="info-card card-purple">
            <div class="icon-wrapper">
              <svg viewBox="0 0 24 24" fill="currentColor" class="card-icon">
                <path d="M4.98 3.5C4.98 4.604 4.104 5.5 3 5.5s-2-.896-2-2 .896-2 2-2 1.98.896 1.98 2ZM.5 8h5V24h-5V8Zm7.5 0h4.79v2.188h.07c.667-1.266 2.298-2.601 4.73-2.601 5.06 0 5.99 3.331 5.99 7.661V24h-5v-7.75c0-1.848-.033-4.227-2.577-4.227-2.58 0-2.975 2.015-2.975 4.094V24h-5V8Z"/>
              </svg>
            </div>

            <div>
              <h2>LinkedIn</h2>
              <p>Professional updates & networking</p>

              <a
                href="https://www.linkedin.com/in/rabiahkhanum2049/"
                target="_blank"
              >
                Connect professionally
              </a>
            </div>
          </div>

          <div class="info-card card-blue">
            <div class="icon-wrapper">
              <svg viewBox="0 0 24 24" fill="currentColor" class="card-icon">
                <path d="M12 0C5.373 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.565 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12Z"/>
              </svg>
            </div>

            <div>
              <h2>GitHub</h2>
              <p>Documentation & technical projects</p>

              <a
                href="https://github.com/Khanum49"
                target="_blank"
              >
                Explore repositories
              </a>
            </div>
          </div>

        </div>

      </div>

      <hr class="section-divider" />

      <!-- Bottom CTA -->
      <div class="bottom-cta">
        <h2 style="font-family: 'Playfair Display', serif;">
          Interested in working together?
        </h2>

        <p>
          Feel free to reach out with opportunities, collaborations,
          or even a thoughtful conversation about docs and engineering.
        </p>

        <a
          href={joinPath(baseUrl, 'docs')}
          class="explore-btn"
        >
          Explore My Work →
        </a>
      </div>

    </div>
  </div>
</BaseLayout>

<style>
  .page-wrapper {
    min-height: 100vh;
    display: flex;
    justify-content: center;
    padding: 7rem 1.25rem 3rem;
  }

  .page-card {
    width: 100%;
    max-width: 1000px;
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border-radius: 2rem;
    padding: 3.5rem 3rem;
    box-shadow: 0 25px 50px -12px rgba(139, 92, 246, 0.15);
    animation: fadeInUp 0.8s ease-out;
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(30px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .eyebrow {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #0d9488;
    margin-bottom: 0.8rem;
  }

  .page-title {
    font-size: clamp(2.3rem, 5vw, 3.2rem);
    line-height: 1.1;
    color: #1e293b;
    font-weight: 700;
  }

  .title-divider {
    width: 270px;
    height: 3px;
    background: linear-gradient(90deg, #0d9488, #8b5cf6);
    border-radius: 999px;
    margin: 1.5rem 0 3rem;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 2.5rem;
    align-items: start;
  }

  .intro-text {
    color: #475569;
    line-height: 1.85;
    font-size: 1rem;
    margin-bottom: 1.4rem;
  }

  .availability-card {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
    background: linear-gradient(135deg, #f0fdfa, #f5f3ff);
    border: 1px solid #d1fae5;
    border-radius: 1.5rem;
    padding: 1.3rem 1.4rem;
    margin-top: 2rem;
    margin-bottom: 2rem;
  }

  .availability-dot {
    width: 25px;
    height: 12px;
    border-radius: 999px;
    background: #14b8a6;
    margin-top: 0.4rem;
    box-shadow: 0 0 0 6px rgba(20, 184, 166, 0.12);
  }

  .availability-card h3 {
    color: #1e293b;
    font-size: 1rem;
    margin-bottom: 0.3rem;
  }

  .availability-card p {
    color: #64748b;
    font-size: 0.94rem;
    line-height: 1.7;
  }

  .quick-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .primary-btn,
  .secondary-btn,
  .explore-btn {
    text-decoration: none;
    font-weight: 600;
    transition: all 0.2s ease;
  }

  .primary-btn {
    background: #0d9488;
    color: white;
    padding: 0.9rem 1.5rem;
    border-radius: 999px;
    box-shadow: 0 8px 20px rgba(13, 148, 136, 0.15);
  }

  .primary-btn:hover {
    background: #0f766e;
    transform: translateY(-1px);
  }

  .secondary-btn {
    border: 1.5px solid #cbd5e1;
    color: #475569;
    padding: 0.9rem 1.5rem;
    border-radius: 999px;
    background: white;
  }

  .secondary-btn:hover {
    border-color: #0d9488;
    color: #0d9488;
  }

  .contact-cards {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .info-card {
    border-radius: 1.5rem;
    padding: 1.4rem;
    display: flex;
    gap: 1rem;
    border: 1px solid transparent;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .info-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 24px rgba(15, 23, 42, 0.06);
  }

  .card-teal {
    background: linear-gradient(135deg, #f0fdfa, #ecfeff);
    border-color: #99f6e4;
  }

  .card-purple {
    background: linear-gradient(135deg, #faf5ff, #f5f3ff);
    border-color: #ddd6fe;
  }

  .card-blue {
    background: linear-gradient(135deg, #eff6ff, #f0f9ff);
    border-color: #bfdbfe;
  }

  .icon-wrapper {
    width: 52px;
    height: 52px;
    border-radius: 1rem;
    background: rgba(255,255,255,0.8);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .card-icon {
    width: 24px;
    height: 24px;
    color: #0f172a;
  }

  .info-card h2 {
    font-size: 1rem;
    color: #1e293b;
    margin-bottom: 0.25rem;
  }

  .info-card p {
    color: #64748b;
    font-size: 0.88rem;
    margin-bottom: 0.7rem;
  }

  .info-card a {
    color: #0d9488;
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 600;
    word-break: break-word;
  }

  .info-card a:hover {
    text-decoration: underline;
  }

  .section-divider {
    border: none;
    border-top: 1px solid #e2e8f0;
    margin: 3rem 0;
  }

  .bottom-cta {
    text-align: center;
    max-width: 700px;
    margin: 0 auto;
  }

  .bottom-cta h2 {
    color: #1e293b;
    font-size: 2rem;
    margin-bottom: 1rem;
  }

  .bottom-cta p {
    color: #64748b;
    line-height: 1.8;
    margin-bottom: 1.8rem;
  }

  .explore-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background: linear-gradient(135deg, #0d9488, #8b5cf6);
    color: white;
    padding: 0.95rem 1.6rem;
    border-radius: 999px;
  }

  .explore-btn:hover {
    transform: translateY(-1px);
    opacity: 0.95;
  }

  @media (max-width: 860px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 480px) {
    .page-card {
      padding: 2.2rem 1.25rem;
      border-radius: 1.5rem;
    }

    .page-title {
      font-size: 2.2rem;
    }

    .quick-links {
      flex-direction: column;
    }

    .primary-btn,
    .secondary-btn {
      width: 100%;
      text-align: center;
    }
  }
</style>