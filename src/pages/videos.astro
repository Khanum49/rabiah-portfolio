---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Videos - Rabiah Khanum">
  <div class="page-wrapper">

    <!-- Header -->
    <div class="page-header">
      <h1 class="page-title">Videos</h1>
      <p class="page-subtitle">
        Conversations about technical writing, engineering, and building documentation for complex systems
      </p>
    </div>

      <!-- Video Grid -->
      <div class="grid md:grid-cols-2 gap-6 mb-8">

        <!-- Card 1: Xgrid -->
        <div class="group video-card">
          <a
            href="https://youtu.be/6H_XQdSKwwA?si=zJPgN0mPNgc_nTBh"
            target="_blank"
            rel="noopener noreferrer"
            class="block h-full flex flex-col bg-white rounded-2xl shadow-md overflow-hidden border border-slate-100 hover:shadow-xl transition-all duration-300 hover:scale-[1.02]"
          >
            <div class="bg-gradient-to-r from-teal-500 to-blue-600 h-[3px]"></div>

            <div class="relative aspect-video bg-gradient-to-br from-teal-100 to-blue-100 overflow-hidden">
              <img
                src="https://img.youtube.com/vi/6H_XQdSKwwA/maxresdefault.jpg"
                alt="Interview with Senior Technical Writer from Serbia"
                class="w-full h-full object-cover"
              />
              <div class="absolute inset-0 flex items-center justify-center bg-black/20 group-hover:bg-black/30 transition-colors">
                <div class="w-14 h-14 bg-white/95 rounded-full flex items-center justify-center shadow-xl group-hover:scale-110 transition-transform duration-300">
                  <svg class="w-7 h-7 text-teal-600 ml-1" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M8 5v14l11-7z"/>
                  </svg>
                </div>
              </div>
            </div>

            <div class="p-4 flex flex-col flex-grow">
              <div class="flex items-center gap-2 mb-2">
                <svg class="w-4 h-4 text-teal-600" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
                </svg>
                <span class="text-xs font-semibold text-teal-600 uppercase tracking-wider">Xgrid Channel</span>
              </div>

              <h3 class="text-lg font-bold text-slate-900 mb-2 group-hover:text-teal-600 transition-colors" style="font-family: 'Playfair Display', serif;">
                Interview with Senior Technical Writer from Serbia
              </h3>

              <p class="text-sm text-slate-600 leading-relaxed mb-3">
                A conversation with a senior technical writer based in Serbia — covering career paths, documentation best practices, and what it looks like to work in tech writing across global software teams.
              </p>

              <div class="flex items-center justify-between pt-3 border-t border-slate-100 mt-auto">
                <div class="flex items-center gap-2 text-xs text-slate-400">
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                  </svg>
                  <span>Xgrid Talks</span>
                </div>
                <div class="text-xs font-medium text-teal-600 group-hover:text-teal-700 flex items-center gap-1">
                  Watch Interview
                  <svg class="w-3.5 h-3.5 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                  </svg>
                </div>
              </div>
            </div>
          </a>
        </div>

        <!-- Card 2: Diana Payton -->
        <div class="group video-card">
          <a
            href="https://youtu.be/UxJkJxiZtLA?si=dSIhVTo9QXygdR7T"
            target="_blank"
            rel="noopener noreferrer"
            class="block h-full flex flex-col bg-white rounded-2xl shadow-md overflow-hidden border border-slate-100 hover:shadow-xl transition-all duration-300 hover:scale-[1.02]"
          >
            <div class="bg-gradient-to-r from-purple-500 to-pink-600 h-[3px]"></div>

            <div class="relative aspect-video bg-gradient-to-br from-purple-100 to-pink-100 overflow-hidden">
              <img
                src="https://img.youtube.com/vi/UxJkJxiZtLA/maxresdefault.jpg"
                alt="My First Year as a Technical Writer"
                class="w-full h-full object-cover"
              />
              <div class="absolute inset-0 flex items-center justify-center bg-black/20 group-hover:bg-black/30 transition-colors">
                <div class="w-14 h-14 bg-white/95 rounded-full flex items-center justify-center shadow-xl group-hover:scale-110 transition-transform duration-300">
                  <svg class="w-7 h-7 text-purple-600 ml-1" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M8 5v14l11-7z"/>
                  </svg>
                </div>
              </div>
            </div>

            <div class="p-4 flex flex-col flex-grow">
              <div class="flex items-center gap-2 mb-2">
                <svg class="w-4 h-4 text-purple-600" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
                </svg>
                <span class="text-xs font-semibold text-purple-600 uppercase tracking-wider">Technical Writing YouTube</span>
              </div>

              <h3 class="text-lg font-bold text-slate-900 mb-2 group-hover:text-purple-600 transition-colors" style="font-family: 'Playfair Display', serif;">
                My First Year as a Technical Writer
              </h3>

              <p class="text-sm text-slate-600 leading-relaxed mb-3">
                Featured on Diana Payton's channel — sharing lessons from my first year transitioning from electrical engineering to technical writing, including challenges, surprises, and what I'd do differently.
              </p>

              <div class="flex items-center justify-between pt-3 border-t border-slate-100 mt-auto">
                <div class="flex items-center gap-2 text-xs text-slate-400">
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                  </svg>
                  <span>Diana Payton — Lead Tech Writer</span>
                </div>
                <div class="text-xs font-medium text-purple-600 group-hover:text-purple-700 flex items-center gap-1">
                  Watch Interview
                  <svg class="w-3.5 h-3.5 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                  </svg>
                </div>
              </div>
            </div>
          </a>
        </div>

      </div>

      <!-- Coming soon note -->
      <div class="bg-gradient-to-r from-blue-50 to-teal-50 rounded-2xl p-6 text-center">
        <div class="max-w-xl mx-auto">
          <h3 class="text-lg font-bold text-slate-900 mb-2" style="font-family: 'Playfair Display', serif;">
            Embedded Players Coming Soon
          </h3>
          <p class="text-sm text-slate-600 leading-relaxed">
            Videos currently link out to YouTube. Embedded players are on the roadmap so you can watch without leaving the site.
          </p>
        </div>
      </div>

    </div>
  </div>
</BaseLayout>

<style>
  .page-wrapper {
    max-width: 960px;
    margin: 0 auto;
    padding: 4.5rem 1.5rem 4rem;
  }

  .page-header {
    text-align: center;
    margin-bottom: 2.5rem;
  }

  .page-title {
    font-family: 'Playfair Display', serif;
    font-size: clamp(2.25rem, 5vw, 3.5rem);
    font-weight: 700;
    color: #1e293b;
    margin-bottom: 0.5rem;
  }

  .page-subtitle {
    font-size: 1rem;
    color: #64748b;
    max-width: 600px;
    margin: 0 auto;
  }
  
  @keyframes fadeInUp {
    from { opacity: 0; transform: translateY(24px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  .video-card:nth-child(1) { animation: fadeInUp 0.7s ease-out both; }
  .video-card:nth-child(2) { animation: fadeInUp 0.7s ease-out 0.1s both; }
</style>