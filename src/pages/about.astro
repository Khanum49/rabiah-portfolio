---
// src/pages/about.astro
import BaseLayout from "../layouts/BaseLayout.astro";

const joinPath = (...parts: string[]) => {
  return parts
    .map((part, index) => {
      if (index > 0 && part.startsWith('/')) part = part.slice(1);
      if (index < parts.length - 1 && part.endsWith('/')) part = part.slice(0, -1);
      return part;
    })
    .join('/');
};

const baseUrl = import.meta.env.BASE_URL;
---

<BaseLayout title="About Me — Rabiah Khanum">
  <div class="page-wrapper">
    <div class="page-card">

      <p class="eyebrow">Get to know me</p>
      <h1 style="font-family: 'Playfair Display', serif;" class="page-title">
        About Me
      </h1>
      <div class="title-divider"></div>

      <div class="about-grid">

        <!-- Main bio -->
        <div class="bio-section">
          <p class="bio-text">
            I'm a <strong>Technical Writer and Electrical Engineer</strong> based in Islamabad, Pakistan,
            currently working at <strong>Xgrid</strong> where I build clear, scalable documentation for
            complex systems, from cloud networking to docs-as-code workflows.
          </p>
          <p class="bio-text">
            My background in electrical engineering gives me a genuine foundation in the technical
            topics I write about: embedded systems, microcontrollers, networking, and firmware. I don't
            just translate jargon, I understand what I'm documenting.
          </p>
          <p class="bio-text">
            I'm a graduate of the <strong>Harvard Aspire Leaders Program</strong>, and I write about what
            I care about: documentation craft, deep reading, and the intersections of engineering and
            storytelling.
          </p>
          <a href="https://www.linkedin.com/in/rabiahkhanum2049/" target="_blank" class="linkedin-btn">
            Connect on LinkedIn
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" width="14" height="14" aria-hidden="true">
              <path fill-rule="evenodd" d="M3 10a.75.75 0 0 1 .75-.75h10.638L10.23 5.29a.75.75 0 1 1 1.04-1.08l5.5 5.25a.75.75 0 0 1 0 1.08l-5.5 5.25a.75.75 0 1 1-1.04-1.08l4.158-3.96H3.75A.75.75 0 0 1 3 10Z" clip-rule="evenodd" />
            </svg>
          </a>
        </div>

        <!-- Skill tags -->
        <div class="skills-section">
          <h2 class="skills-title">What I work with</h2>
          <div class="tags">
            <span class="tag tag-teal">Technical Writing</span>
            <span class="tag tag-teal">Docs-as-Code</span>
            <span class="tag tag-teal">reStructuredText / Markdown</span>
            <span class="tag tag-purple">Astro</span>
            <span class="tag tag-purple">GitHub / VSCode</span>
            <span class="tag tag-purple">Sphinx</span>
            <span class="tag tag-blue">Cloud</span>
            <span class="tag tag-blue">Networking</span>
            <span class="tag tag-blue">Linux</span>
            <span class="tag tag-pink">API Docs</span>
            <span class="tag tag-pink">Postman</span>
            <span class="tag tag-pink">REST APIs</span>
          </div>
        </div>

      </div>

      <hr class="section-divider" />

      <!-- Quick links -->
      <h2 style="font-family: 'Playfair Display', serif;" class="section-heading">
        Explore my work
      </h2>
      <div class="links-grid">
        <a href={joinPath(baseUrl, 'docs')} class="work-card work-card-teal">
          <span class="work-card-label">Documentation</span>
          <span class="work-card-desc">Technical guides & articles</span>
        </a>
        <a href={joinPath(baseUrl, 'api-docs')} class="work-card work-card-purple">
          <span class="work-card-label">API Docs</span>
          <span class="work-card-desc">OpenAPI & REST samples</span>
        </a>
        <a href={joinPath(baseUrl, 'blogs')} class="work-card work-card-teal">
          <span class="work-card-label">Blogs</span>
          <span class="work-card-desc">Articles & essays</span>
        </a>
        <a href={joinPath(baseUrl, 'videos')} class="work-card work-card-purple">
          <span class="work-card-label">Videos</span>
          <span class="work-card-desc">Interviews & talks</span>
        </a>
        <a href={joinPath(baseUrl, 'resume')} class="work-card work-card-teal">
            <span class="work-card-label">My Resume</span>
            <span class="work-card-desc">Detailed Experience & Tech Stack</span>
          </a>
      </div>

    </div>
  </div>
</BaseLayout>

<style>
  .page-wrapper {
    min-height: 100vh;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding: 7rem 1.25rem 3rem;
  }

  .page-card {
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border-radius: 2rem;
    box-shadow: 0 25px 50px -12px rgba(139, 92, 246, 0.15);
    padding: 3.5rem 3rem;
    max-width: 1000px;
    width: 100%;
    animation: fadeInUp 0.8s ease-out;
  }

  @keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(30px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
  }

  .eyebrow {
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: #0d9488;
    margin-bottom: 0.75rem;
  }

  .page-title {
    font-size: clamp(2rem, 5vw, 2.75rem);
    font-weight: 700;
    color: #1e293b;
    line-height: 1.15;
  }

  .title-divider {
    width: 200px;
    height: 3px;
    background: linear-gradient(90deg, #0d9488, #6366f1);
    border-radius: 99px;
    margin: 1.5rem 0 2.5rem;
  }

  /* Bio + skills layout */
  .about-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    margin-bottom: 2.5rem;
  }

  @media (max-width: 640px) {
    .about-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }

  .bio-text {
    color: #475569;
    font-size: 0.975rem;
    line-height: 1.75;
    margin-bottom: 1.25rem;
  }

  .bio-text strong {
    color: #1e293b;
    font-weight: 600;
  }

  .linkedin-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background: #0d9488;
    color: #ffff;
    font-size: 0.875rem;
    font-weight: 500;
    text-decoration: none;
    padding: 0.55rem 1.1rem;
    border: 1.5px solid #0d9488;
    border-radius: 99px;
    margin-top: 0.5rem;
    transition: background 0.2s, color 0.2s;
  }

  .linkedin-btn:hover {
    background: #ffff;
    color: #0d9488;
  }

  /* Skills */
  .skills-title {
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: #94a3b8;
    margin-bottom: 1rem;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .tag {
    font-size: 0.8rem;
    font-weight: 500;
    padding: 0.3rem 0.75rem;
    border-radius: 99px;
  }

  .tag-teal  { background: #ccfbf1; color: #0f766e; }
  .tag-purple { background: #ede9fe; color: #6d28d9; }
  .tag-blue  { background: #dbeafe; color: #1d4ed8; }
  .tag-pink  { background: #FCE7F3; color: #be185d; }

  /* Section divider */
  .section-divider {
    border: none;
    border-top: 1px solid #e2e8f0;
    margin: 2.5rem 0;
  }

  .section-heading {
    font-size: 1.5rem;
    color: #1e293b;
    margin-bottom: 1.5rem;
  }

  /* Work links grid */
  .links-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: 1rem;
  }

  .work-card {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding: 1.25rem 1.25rem;
    border-radius: 1rem;
    text-decoration: none;
    border: 1px solid transparent;
    transition: transform 0.15s, box-shadow 0.15s;
  }

  .work-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 16px rgba(0,0,0,0.08);
  }

  .work-card-teal  { background: linear-gradient(135deg, #f0fdf4, #e0f2fe); border-color: #99f6e4; }
  .work-card-purple { background: linear-gradient(135deg, #faf5ff, #f0e6ff); border-color: #ddd6fe; }

  
  .work-card-label { font-size: 0.925rem; font-weight: 600; color: #1e293b; }
  .work-card-desc  { font-size: 0.78rem; color: #64748b; }

  /* Responsive card padding */
  @media (max-width: 480px) {
    .page-card {
      padding: 2.25rem 1.25rem;
      border-radius: 1.5rem;
    }
  }
</style>